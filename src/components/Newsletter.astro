---
import { SITE } from '../lib/site';
const substack = SITE.substack.replace(/\/$/, '');
---
<section id="newsletter" class="newsletter">
  <div class="wrap nl-row">
    <div class="nl-text">
      <h2>Receba os artigos e as campanhas por e-mail</h2>
      <p>Só os textos e as campanhas que importam. Sem spam. Cancele quando quiser.</p>
    </div>
    <div class="nl-form">
      {substack ? (
        <>
          <iframe
            src={`${substack}/embed`}
            title="Inscrição na newsletter do CicloRota BH"
            loading="lazy"
            height="150"
          ></iframe>
          <p class="nl-note">A inscrição é feita pelo Substack. Veja a <a href="/privacidade/">Política de privacidade</a>.</p>
        </>
      ) : (
        <>
          <p class="nl-soon">A inscrição abre em breve. Enquanto isso, acompanhe pelo Instagram.</p>
          <a class="btn btn-sun" href={SITE.instagram} rel="noopener">Seguir no Instagram</a>
        </>
      )}
    </div>
  </div>
</section>
<style>
  .newsletter { background: var(--ink); color: #fff; }
  .nl-row { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; padding-block: 64px; }
  .nl-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .nl-text h2 { font-size: clamp(34px, 5vw, 44px); }
  .nl-text p { color: #c9d6d5; }
  .nl-form { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .nl-form iframe { width: 100%; border: 0; border-radius: 8px; background: #fff; }
  .nl-note, .nl-soon { font-size: 15px; color: #c9d6d5; }
  .nl-note a { color: var(--mint); }
</style>
