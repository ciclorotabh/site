---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" noindex>
  <section class="wrap nf">
    <p class="eyebrow">Erro 404</p>
    <h1>Essa página não existe mais, ou nunca existiu</h1>
    <p class="lede">O site do CicloRota mudou em novembro de 2026. Os artigos continuam nos mesmos endereços, mas algumas páginas antigas saíram.</p>
    <div class="ctas">
      <a class="btn btn-accent" href="/artigos/">Ver os artigos</a>
      <a class="btn btn-outline" href="/">Ir para a página inicial</a>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: 80px; display: flex; flex-direction: column; gap: 18px; }
  .nf h1 { font-size: clamp(40px, 7vw, 60px); max-width: 16em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
