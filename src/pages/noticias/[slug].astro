---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { noticias } from '../../lib/conteudo';
import { dataLonga } from '../../lib/site';

export async function getStaticPaths() {
  return (await noticias()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const og = entry.data.cover ? (await getImage({ src: entry.data.cover, width: 1200, format: 'jpg' })).src : undefined;
---
<Base title={entry.data.title} description={entry.data.description} image={og} type="article">
  <article class="wrap post">
    <header class="post-head">
      <p class="eyebrow"><a href="/noticias/">Notícias</a> · {entry.data.tipo}</p>
      <h1>{entry.data.title}</h1>
      <p class="muted">{dataLonga(entry.data.date)}{entry.data.eventDate && ` · evento em ${dataLonga(entry.data.eventDate)}`}{entry.data.place && ` · ${entry.data.place}`}</p>
    </header>
    {entry.data.cover && <Image src={entry.data.cover} alt={entry.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 860px" class="cover" />}
    <div class="prose"><Content /></div>
    {entry.data.externalUrl && <p><a class="btn btn-outline" href={entry.data.externalUrl} rel="noopener">Ver a publicação original</a></p>}
  </article>
</Base>
<style>
  .post { padding-block: 48px 72px; display: flex; flex-direction: column; gap: 24px; }
  .post-head { max-width: 46em; display: flex; flex-direction: column; gap: 12px; }
  .post-head h1 { font-size: clamp(36px, 6vw, 54px); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .cover { width: 100%; max-width: 860px; height: auto; border-radius: 10px; }
</style>
