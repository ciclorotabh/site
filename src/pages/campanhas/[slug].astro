---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE, dataLonga, numeroBR } from '../../lib/site';

export async function getStaticPaths() {
  const lista = await getCollection('campanhas', ({ data }) => import.meta.env.DEV || data.status !== 'rascunho');
  return lista.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const aberta = entry.data.status === 'aberta';
const og = entry.data.cover ? (await getImage({ src: entry.data.cover, width: 1200, format: 'jpg' })).src : undefined;
const destino = entry.data.target ?? 'às autoridades responsáveis';
---
<Base title={entry.data.title} description={entry.data.description} image={og}>
  <Fragment slot="head">
    {aberta && SITE.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </Fragment>
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow">{aberta ? 'Campanha aberta' : 'Campanha encerrada'}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      {entry.data.closesAt && <p class="small">{aberta ? 'Assinaturas até' : 'Encerrada em'} {dataLonga(entry.data.closesAt)}.</p>}
    </div>
  </section>

  <section class="wrap grid">
    <div class="texto">
      {entry.data.cover && <Image src={entry.data.cover} alt={entry.data.coverAlt ?? ''} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 700px" class="cover" />}
      <div class="prose"><Content /></div>
    </div>

    <aside class="form-box" id="assinar">
      <p class="contador"><strong class="tabular" id="total" data-campanha={entry.id}>…</strong> assinaturas{entry.data.goal && <span class="muted"> de {numeroBR(entry.data.goal)}</span>}</p>
      {entry.data.goal && <div class="meta-bar" aria-hidden="true"><span id="barra" data-meta={entry.data.goal}></span></div>}
      {aberta ? (
        <form id="form-assinar" novalidate>
          <input type="hidden" name="campanha" value={entry.id} />
          <label for="f-nome">Nome completo</label>
          <input id="f-nome" name="nome" autocomplete="name" required minlength="3" maxlength="120" />
          <label for="f-email">E-mail</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          <label for="f-bairro">Bairro <span class="muted">(opcional)</span></label>
          <input id="f-bairro" name="bairro" autocomplete="address-level3" maxlength="80" />
          <label class="check"><input type="checkbox" name="consentimento" required /> <span>Concordo que meu nome e bairro sejam entregues {destino} e que meus dados sejam tratados conforme a <a href="/privacidade/">Política de privacidade</a>.</span></label>
          <label class="check"><input type="checkbox" name="outros" /> <span>Quero receber outras campanhas e notícias do CicloRota BH por e-mail. (Opcional, não é preciso para assinar.)</span></label>
          {SITE.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={SITE.turnstileSiteKey} data-language="pt-br"></div>}
          <button type="submit" class="btn btn-sun">Assinar</button>
          <p id="f-msg" class="msg" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <p class="muted">Esta campanha não recebe mais assinaturas. Obrigado a quem participou.</p>
      )}
    </aside>
  </section>

  <section class="band">
    <div class="wrap dados">
      <h2>Como seus dados são tratados</h2>
      <div class="cols">
        <div><h3>O que coletamos</h3><p>Nome, e-mail e, se você quiser, o bairro.</p></div>
        <div><h3>Para quê</h3><p>A lista com nome e bairro é entregue {destino}. O e-mail não é entregue a ninguém.</p></div>
        <div><h3>Por quanto tempo</h3><p>Até 12 meses depois do fim da campanha. Depois, as assinaturas são apagadas.</p></div>
        <div><h3>Seus direitos</h3><p>Você pode pedir acesso, correção ou exclusão. Veja a <a href="/privacidade/">Política de privacidade</a>.</p></div>
      </div>
    </div>
  </section>
</Base>

<script>
  const total = document.getElementById('total');
  const barra = document.getElementById('barra');
  const campanha = total?.dataset.campanha;
  async function atualiza() {
    if (!campanha || !total) return;
    try {
      const r = await fetch(`/api/contagem/${campanha}`);
      const j = (await r.json()) as { total: number };
      total.textContent = j.total.toLocaleString('pt-BR');
      if (barra) barra.style.width = Math.min(100, (j.total / Number(barra.dataset.meta)) * 100) + '%';
    } catch { total.textContent = '—'; }
  }
  atualiza();

  const form = document.getElementById('form-assinar') as HTMLFormElement | null;
  const msg = document.getElementById('f-msg');
  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!form.reportValidity() || !msg) return;
    const botao = form.querySelector('button')!;
    botao.disabled = true;
    msg.textContent = 'Enviando…';
    try {
      const r = await fetch('/api/assinar', { method: 'POST', body: new FormData(form) });
      const j = (await r.json()) as { ok: boolean; status?: string; erro?: string };
      if (j.ok) {
        msg.textContent = j.status === 'repetida' ? 'Este e-mail já tinha assinado. Obrigado!' : 'Assinatura registrada. Obrigado! Compartilhe a campanha.';
        form.reset();
        atualiza();
      } else {
        msg.textContent = j.erro ?? 'Não deu certo. Tente de novo.';
      }
    } catch {
      msg.textContent = 'Sem conexão. Tente de novo.';
    } finally {
      botao.disabled = false;
      (window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
    }
  });
</script>

<style>
  .hero { background: var(--sun); }
  .hero-in { padding-block: 48px; display: flex; flex-direction: column; gap: 14px; }
  .hero h1 { font-size: clamp(40px, 7vw, 64px); }
  .hero .lede { color: var(--ink); }
  .small { font-size: 16px; }
  .grid { display: flex; flex-wrap: wrap; gap: 40px; padding-block: 48px 64px; align-items: flex-start; }
  .texto { flex: 3 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .cover { width: 100%; height: auto; border-radius: 10px; }
  .form-box { flex: 1 1 320px; min-width: 0; border: 2px solid var(--ink); border-radius: 12px; padding: 24px; position: sticky; top: 16px; display: flex; flex-direction: column; gap: 12px; }
  .contador { font-size: 18px; }
  .contador strong { font-family: var(--font-display); font-size: 44px; }
  .meta-bar { height: 10px; background: var(--band); border-radius: 5px; overflow: hidden; }
  .meta-bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .4s; }
  form { display: flex; flex-direction: column; gap: 8px; }
  form label { font-weight: 600; font-size: 16px; }
  form input:not([type='checkbox']) { min-height: 48px; padding: 0 14px; border: 1px solid #8fa3a2; border-radius: 6px; font: 400 17px var(--font-body); }
  .check { display: flex; gap: 10px; align-items: flex-start; font-weight: 400 !important; font-size: 15px !important; margin-top: 6px; }
  .check input { width: 20px; height: 20px; margin-top: 2px; flex: 0 0 20px; accent-color: var(--accent); }
  .msg { min-height: 1.4em; font-weight: 600; }
  .dados { padding-block: 48px; display: flex; flex-direction: column; gap: 20px; }
  .dados h2 { font-size: 36px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .cols > div { background: var(--paper); border-radius: 10px; padding: 18px; display: flex; flex-direction: column; gap: 6px; }
  .cols h3 { font-family: var(--font-body); font-size: 18px; font-weight: 700; }
  .cols p { font-size: 16px; color: var(--ink-2); }
</style>
