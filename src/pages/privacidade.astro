---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { dataLonga } from '../lib/site';
const pagina = await getEntry('paginas', 'privacidade');
if (!pagina) throw new Error('Página de privacidade não encontrada');
const { Content } = await render(pagina);
---
<Base title={pagina.data.title} description={pagina.data.description}>
  <article class="wrap pg">
    <h1>{pagina.data.title}</h1>
    {pagina.data.updated && <p class="muted">Atualizada em {dataLonga(pagina.data.updated)}.</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>
<style>
  .pg { padding-block: 48px 72px; display: flex; flex-direction: column; gap: 16px; }
  .pg h1 { font-size: clamp(40px, 7vw, 60px); }
</style>
