---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { artigos } from '../../lib/conteudo';
import { dataLonga, minutosLeitura } from '../../lib/site';

export async function getStaticPaths() {
  const lista = await artigos();
  return lista.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, anterior: lista[i + 1], proximo: lista[i - 1] } }));
}

const { entry, anterior, proximo } = Astro.props;
const { Content } = await render(entry);
const og = entry.data.cover ? (await getImage({ src: entry.data.cover, width: 1200, format: 'jpg' })).src : undefined;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString(),
  dateModified: (entry.data.updated ?? entry.data.date).toISOString(),
  author: { '@type': 'Person', name: 'Cristiano Scarpelli' },
  publisher: { '@type': 'Organization', name: 'CicloRota BH' },
};
---
<Base title={entry.data.title} description={entry.data.description} image={og} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <article class="wrap post">
    <header class="post-head">
      <p class="eyebrow"><a href="/artigos/">Artigos</a></p>
      <h1>{entry.data.title}</h1>
      <p class="meta muted">
        <span>Cristiano Scarpelli</span>
        <span>{dataLonga(entry.data.date)}</span>
        <span>{minutosLeitura(entry.body)} min de leitura</span>
      </p>
      {entry.data.tags.length > 0 && (
        <ul class="tags">{entry.data.tags.map((t) => <li>{t}</li>)}</ul>
      )}
    </header>
    {entry.data.cover && (
      <Image src={entry.data.cover} alt={entry.data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 860px" class="cover" loading="eager" />
    )}
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      <p class="muted">Gostou? Compartilhe e <a href="/#newsletter">receba os próximos por e-mail</a>.</p>
      <nav class="pager" aria-label="Outros artigos">
        {anterior && <a href={`/artigo/${anterior.id}/`}><span class="muted">Anterior</span>{anterior.data.title}</a>}
        {proximo && <a href={`/artigo/${proximo.id}/`} class="next"><span class="muted">Próximo</span>{proximo.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>

<style>
  .post { padding-block: 48px 72px; display: flex; flex-direction: column; gap: 28px; }
  .post-head { max-width: 46em; display: flex; flex-direction: column; gap: 14px; }
  .post-head h1 { font-size: clamp(38px, 6vw, 60px); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 16px; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: 14px; font-weight: 600; padding: 2px 10px; border-radius: 999px; background: var(--band); color: var(--ink-2); }
  .cover { width: 100%; max-width: 860px; height: auto; border-radius: 10px; }
  .post-foot { max-width: 46em; display: flex; flex-direction: column; gap: 20px; border-top: 1px solid var(--line); padding-top: 24px; }
  .pager { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; }
  .pager a { flex: 1 1 260px; display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); font-weight: 600; border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }
  .pager span { font-weight: 400; font-size: 14px; }
</style>
