---
import Base from '../../layouts/Base.astro';
import { artigos } from '../../lib/conteudo';
import { dataCurta, numeroBR } from '../../lib/site';
import dados from '../../data/contagens.json';

const meses = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
const d = (iso: string) => new Date(iso + 'T12:00:00Z');
const mesAno = (iso: string) => `${meses[d(iso).getUTCMonth()]}/${d(iso).getUTCFullYear()}`;

const anos = [...new Set(dados.locais.flatMap((l) => Object.keys(l.mediaHoraPorAno)))].sort();
// Par padrão da comparação: os dois anos com mais locais em comum
let par: [string, string] = [anos[0], anos[1] ?? anos[0]];
let melhor = -1;
for (let i = 0; i < anos.length; i++)
  for (let j = i + 1; j < anos.length; j++) {
    const n = dados.locais.filter((l) => anos[i] in l.mediaHoraPorAno && anos[j] in l.mediaHoraPorAno).length;
    if (n > melhor) { melhor = n; par = [anos[i], anos[j]]; }
  }

// Artigos ligados a cada local (campo "locais" do artigo)
const lista = await artigos();
const artigosPorLocal: Record<string, { titulo: string; url: string }[]> = {};
for (const a of lista)
  for (const nome of a.data.locais) {
    const loc = dados.locais.find((l) => l.nome === nome);
    if (loc) (artigosPorLocal[loc.id] ??= []).push({ titulo: a.data.title, url: `/artigo/${a.id}/` });
  }

const locaisCliente = dados.locais.map((l) => ({
  id: l.id, nome: l.nome, lat: l.lat, lon: l.lon, media: l.mediaHoraPorAno, contagens: l.contagens,
  max24h: l.max24h, ultima: l.ultimaContagem, horaAHora: l.horaAHora, artigos: artigosPorLocal[l.id] ?? [],
}));

// Curva do dia: média de cada hora nos dias com contagem hora a hora, por local
const perfisPorLocal = new Map<string, typeof dados.perfis>();
for (const p of dados.perfis) perfisPorLocal.set(p.local, [...(perfisPorLocal.get(p.local) ?? []), p]);
const curvas = [...perfisPorLocal.entries()].map(([id, dias]) => {
  const media = Array.from({ length: 24 }, (_, h) => {
    const v = dias.map((x) => x.horas[h]).filter((x): x is number => x !== null);
    return v.length ? v.reduce((s, x) => s + x, 0) / v.length : 0;
  });
  const pico = media.indexOf(Math.max(...media));
  const totais = dias.map((x) => ({ data: x.data, total: x.horas.reduce<number>((s, v) => s + (v ?? 0), 0) }));
  return { local: dados.locais.find((l) => l.id === id)!, dias, media, pico, totais, max: Math.max(...media) };
});

const recentes = [...dados.contagens].reverse().slice(0, 20);
const nomePorId = Object.fromEntries(dados.locais.map((l) => [l.id, l.nome]));
const W = 720, H = 240, P = { l: 36, r: 8, t: 16, b: 28 };
---
<Base title="CicloDados" description={`Mapa das contagens de ciclistas em Belo Horizonte: ${dados.totalContagens} contagens em ${dados.locais.length} locais.`}>
  <section class="wrap head">
    <p class="eyebrow">CicloDados</p>
    <h1>Quantos ciclistas passam em cada ponto de BH</h1>
    <p class="lede">{numeroBR(dados.totalContagens)} contagens em {dados.locais.length} locais, de {mesAno(dados.primeiraData!)} a {mesAno(dados.ultimaData!)}. Contagens presenciais e por vídeo, de 1, 2, 12 e 24 horas. Toque num ponto para ver os números.</p>
  </section>

  <section class="wrap">
    <div class="controls">
      <label for="f-ano">Ano</label>
      <select id="f-ano">
        <option value="recente">Mais recente de cada local</option>
        {[...anos].reverse().map((a) => <option value={a}>{a}</option>)}
      </select>
      <span class="muted small">Tamanho do ponto: média de ciclistas por hora nas contagens de 1 hora.</span>
    </div>
    <div class="map-row">
      <div id="mapa" class="map" role="region" aria-label="Mapa das contagens"></div>
      <aside class="panel" aria-live="polite" id="painel">
        <p class="panel-eyebrow">Local selecionado</p>
        <p class="panel-name" id="p-nome">Escolha um ponto no mapa</p>
        <p class="panel-num tabular" id="p-num"></p>
        <p id="p-unid"></p>
        <ul class="panel-list" id="p-lista"></ul>
        <div id="p-artigos"></div>
      </aside>
    </div>
    <noscript><p class="muted">O mapa precisa de JavaScript. A tabela completa está mais abaixo e no CSV.</p></noscript>
  </section>

  <section class="band">
    <div class="wrap block">
      <div class="block-head">
        <div>
          <h2 id="cmp-titulo">De {par[0]} para {par[1]}: ciclistas por hora</h2>
          <p class="muted">Média das contagens de 1 hora nos locais contados nos dois anos.</p>
        </div>
        <div class="cmp-controls">
          <label>De <select id="cmp-a">{anos.map((a) => <option value={a} selected={a === par[0]}>{a}</option>)}</select></label>
          <label>para <select id="cmp-b">{anos.map((a) => <option value={a} selected={a === par[1]}>{a}</option>)}</select></label>
        </div>
      </div>
      <div class="cmp-box">
        <div class="legend"><span><i class="c-a"></i><b id="lg-a">{par[0]}</b></span><span><i class="c-b"></i><b id="lg-b">{par[1]}</b></span></div>
        <div id="cmp-linhas"></div>
      </div>
      <p class="muted small">Contagens feitas em dias e horários diferentes. Leia a tendência, não o número exato.</p>
    </div>
  </section>

  {curvas.map((c) => (
    <section class="wrap block">
      <div class="block-head">
        <div>
          <p class="eyebrow">Hora a hora</p>
          <h2>A curva do dia na {c.local.nome}</h2>
          <p class="muted">Média de cada hora em {c.dias.length} dias de contagem de 24 horas ({c.totais.map((t) => dataCurta(d(t.data))).join(', ')}). O pico é das {c.pico}h às {c.pico + 1}h.</p>
        </div>
      </div>
      <figure class="chart">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Ciclistas por hora ao longo do dia na ${c.local.nome}. Pico das ${c.pico}h às ${c.pico + 1}h com média de ${numeroBR(c.max, 1)}.`}>
          {[0, 0.25, 0.5, 0.75, 1].map((f) => {
            const y = P.t + (H - P.t - P.b) * (1 - f);
            return (<g><line x1={P.l} x2={W - P.r} y1={y} y2={y} class="grid" /><text x={P.l - 6} y={y + 4} class="axis" text-anchor="end">{Math.round(c.max * f)}</text></g>);
          })}
          {c.media.map((v, h) => {
            const bw = (W - P.l - P.r) / 24;
            const bh = (H - P.t - P.b) * (v / c.max);
            return (
              <g>
                <rect x={P.l + h * bw + 2} y={H - P.b - bh} width={bw - 4} height={bh} rx="2" class={h === c.pico ? 'bar peak' : 'bar'}><title>{h}h às {h + 1}h: {numeroBR(v, 1)} ciclistas (média)</title></rect>
                {h % 3 === 0 && <text x={P.l + h * bw + bw / 2} y={H - 8} class="axis" text-anchor="middle">{h}h</text>}
              </g>
            );
          })}
        </svg>
        <figcaption class="muted small">Totais de 24 horas: {c.totais.map((t) => `${dataCurta(d(t.data))}: ${numeroBR(t.total)}`).join(' · ')}. As janelas de 1, 2 e 12 horas do mapa saem destas horas: 18h às 19h, 17h às 19h e 7h às 19h.</figcaption>
      </figure>
    </section>
  ))}

  <section class="wrap block" id="dados-abertos">
    <div class="block-head">
      <h2>Contagens mais recentes</h2>
      <a class="btn btn-outline" href="/ciclodados/contagens.csv" download>Baixar todas (CSV)</a>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Data</th><th scope="col">Período</th><th scope="col" class="num">Ciclistas</th><th scope="col">Local</th><th scope="col">Tipo</th><th scope="col">Fonte</th></tr></thead>
        <tbody>
          {recentes.map((r) => (
            <tr><td class="tabular">{dataCurta(d(r.data))}</td><td>{r.periodo} {r.periodo === 1 ? 'hora' : 'horas'}</td><td class="num tabular">{numeroBR(r.ciclistas)}</td><td>{nomePorId[r.local]}</td><td>{r.tipo}</td><td class="muted">{r.fonte.join(', ')}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted small">Dados abertos: use à vontade citando o CicloRota BH. Atualizado em {dataCurta(new Date(dados.geradoEm))}.</p>
  </section>

  <script type="application/json" id="dados-locais" set:html={JSON.stringify(locaisCliente)} />
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  type Local = { id: string; nome: string; lat: number; lon: number; media: Record<string, number>; contagens: number;
    max24h: { ciclistas: number; data: string } | null; ultima: string; horaAHora: boolean; artigos: { titulo: string; url: string }[] };

  const locais: Local[] = JSON.parse(document.getElementById('dados-locais')!.textContent || '[]');
  const fmt = (n: number, c = 1) => n.toLocaleString('pt-BR', { minimumFractionDigits: c, maximumFractionDigits: c });
  const dataBR = (iso: string) => iso.split('-').reverse().join('/');
  const valor = (l: Local, ano: string): [number, string] | null => {
    if (ano === 'recente') {
      const anos = Object.keys(l.media).sort();
      return anos.length ? [l.media[anos[anos.length - 1]], anos[anos.length - 1]] : null;
    }
    return ano in l.media ? [l.media[ano], ano] : null;
  };
  const maxGeral = Math.max(...locais.flatMap((l) => Object.values(l.media)), 1);
  const raio = (v: number) => 5 + 22 * Math.sqrt(v / maxGeral);

  const mapa = L.map('mapa', { scrollWheelZoom: false }).setView([-19.905, -43.95], 12);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 18,
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  }).addTo(mapa);
  const camada = L.layerGroup().addTo(mapa);
  let selecionado: string | null = null;

  function mostra(l: Local, ano: string) {
    selecionado = l.id;
    const v = valor(l, ano);
    document.getElementById('p-nome')!.textContent = l.nome;
    document.getElementById('p-num')!.textContent = v ? fmt(v[0]) : '—';
    document.getElementById('p-unid')!.textContent = v ? `ciclistas por hora, média de ${v[1]}` : 'sem contagem de 1 hora neste ano';
    const ul = document.getElementById('p-lista')!;
    ul.replaceChildren();
    const item = (t: string) => { const li = document.createElement('li'); li.textContent = t; ul.appendChild(li); };
    item(`${l.contagens} contagens, a última em ${dataBR(l.ultima)}`);
    if (l.max24h) item(`Máximo em 24 h: ${l.max24h.ciclistas.toLocaleString('pt-BR')} ciclistas (${dataBR(l.max24h.data)})`);
    Object.keys(l.media).sort().forEach((a) => item(`${a}: ${fmt(l.media[a])} por hora`));
    if (l.horaAHora) item('Tem contagem hora a hora (veja a curva do dia abaixo)');
    const arts = document.getElementById('p-artigos')!;
    arts.replaceChildren();
    l.artigos.forEach((a) => { const el = document.createElement('a'); el.href = a.url; el.textContent = a.titulo; arts.appendChild(el); });
    desenha();
  }

  function desenha() {
    const ano = (document.getElementById('f-ano') as HTMLSelectElement).value;
    camada.clearLayers();
    locais
      .map((l) => ({ l, v: valor(l, ano) }))
      .filter((x) => x.v)
      .sort((a, b) => b.v![0] - a.v![0])
      .forEach(({ l, v }) => {
        const m = L.circleMarker([l.lat, l.lon], {
          radius: raio(v![0]), weight: 2, color: '#FFFFFF', fillOpacity: 0.85,
          fillColor: l.id === selecionado ? '#C47F00' : '#008C99',
        });
        m.bindTooltip(`${l.nome}: ${fmt(v![0])} por hora (${v![1]})`);
        m.on('click', () => mostra(l, ano));
        m.addTo(camada);
      });
  }
  document.getElementById('f-ano')!.addEventListener('change', () => {
    const l = locais.find((x) => x.id === selecionado);
    if (l) mostra(l, (document.getElementById('f-ano') as HTMLSelectElement).value); else desenha();
  });
  const inicial = [...locais].sort((a, b) => (b.max24h?.ciclistas ?? 0) - (a.max24h?.ciclistas ?? 0))[0];
  if (inicial) mostra(inicial, 'recente'); else desenha();

  // Comparação entre anos
  const selA = document.getElementById('cmp-a') as HTMLSelectElement;
  const selB = document.getElementById('cmp-b') as HTMLSelectElement;
  function compara() {
    const a = selA.value, b = selB.value;
    document.getElementById('cmp-titulo')!.textContent = `De ${a} para ${b}: ciclistas por hora`;
    document.getElementById('lg-a')!.textContent = a;
    document.getElementById('lg-b')!.textContent = b;
    const linhas = locais.filter((l) => a in l.media && b in l.media).sort((x, y) => (y.media[b] - y.media[a]) - (x.media[b] - x.media[a]));
    const caixa = document.getElementById('cmp-linhas')!;
    caixa.replaceChildren();
    if (!linhas.length || a === b) {
      const p = document.createElement('p'); p.className = 'muted';
      p.textContent = a === b ? 'Escolha dois anos diferentes.' : 'Nenhum local tem contagem de 1 hora nos dois anos.';
      caixa.appendChild(p); return;
    }
    const esc = Math.max(...linhas.flatMap((l) => [l.media[a], l.media[b]])) * 1.04;
    const pct = (v: number) => (v / esc) * 100;
    for (const l of linhas) {
      const va = l.media[a], vb = l.media[b];
      const row = document.createElement('div'); row.className = 'cmp-row';
      const nome = document.createElement('span'); nome.className = 'cmp-nome';
      const nm = document.createElement('b'); nm.textContent = l.nome;
      const vv = document.createElement('span'); vv.className = 'cmp-vals tabular';
      const delta = vb - va;
      vv.textContent = `${fmt(va)} → ${fmt(vb)} (${delta >= 0 ? '+' : ''}${fmt(delta)})`;
      nome.append(nm, vv);
      const trilho = document.createElement('div'); trilho.className = 'cmp-track';
      trilho.setAttribute('role', 'img');
      trilho.setAttribute('aria-label', `${l.nome}: ${fmt(va)} em ${a} e ${fmt(vb)} em ${b}`);
      const seg = document.createElement('div'); seg.className = 'cmp-seg';
      seg.style.left = pct(Math.min(va, vb)) + '%'; seg.style.width = Math.abs(pct(vb) - pct(va)) + '%';
      const da = document.createElement('div'); da.className = 'cmp-dot c-a'; da.style.left = pct(va) + '%';
      const db = document.createElement('div'); db.className = 'cmp-dot c-b'; db.style.left = pct(vb) + '%';
      trilho.append(seg, da, db);
      row.append(nome, trilho);
      caixa.appendChild(row);
    }
  }
  selA.addEventListener('change', compara);
  selB.addEventListener('change', compara);
  compara();
</script>

<style>
  .head { padding-block: 56px 24px; display: flex; flex-direction: column; gap: 14px; }
  .head h1 { font-size: clamp(40px, 7vw, 64px); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; background: var(--band); border-radius: 10px; padding: 14px 18px; margin-bottom: 16px; }
  .controls label { font-weight: 600; }
  select { min-height: 44px; border: 1px solid #8fa3a2; border-radius: 6px; padding: 0 12px; font: 400 17px var(--font-body); background: #fff; color: var(--ink); }
  .small { font-size: 15px; }
  .map-row { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 56px; }
  .map { flex: 3 1 520px; min-width: 0; height: min(70vh, 560px); min-height: 380px; border-radius: 10px; z-index: 0; }
  .panel { flex: 1 1 260px; min-width: 0; background: var(--ink); color: #fff; border-radius: 10px; padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .panel-eyebrow { text-transform: uppercase; letter-spacing: 0.1em; font-size: 13px; font-weight: 600; color: var(--mint); }
  .panel-name { font-size: 24px; font-weight: 600; line-height: 1.2; }
  .panel-num { font-family: var(--font-display); font-weight: 700; font-size: 84px; line-height: 0.95; color: var(--sun); }
  .panel-list { margin: 6px 0 0; padding-left: 18px; color: #c9d6d5; font-size: 16px; display: flex; flex-direction: column; gap: 4px; }
  #p-artigos { display: flex; flex-direction: column; gap: 6px; margin-top: 6px; }
  #p-artigos :global(a) { color: var(--mint); font-weight: 600; font-size: 16px; }
  .block { padding-block: 56px; display: flex; flex-direction: column; gap: 22px; }
  .block-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .block-head h2 { font-size: clamp(30px, 5vw, 40px); }
  .block-head p { margin-top: 6px; }
  .cmp-controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font-weight: 600; }
  .cmp-controls label { display: flex; gap: 8px; align-items: center; }
  .cmp-box { background: #fff; border-radius: 10px; padding: 24px 28px; display: flex; flex-direction: column; gap: 6px; }
  .legend { display: flex; gap: 20px; font-size: 15px; color: var(--ink-2); margin-bottom: 6px; }
  .legend span { display: flex; align-items: center; gap: 8px; }
  .legend i { width: 12px; height: 12px; border-radius: 50%; display: inline-block; }
  .c-a { background: var(--y2023); }
  .c-b { background: var(--y2024); }
  :global(.cmp-row) { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 20px; padding: 10px 0; border-top: 1px solid var(--line); }
  :global(.cmp-nome) { flex: 0 1 260px; min-width: 0; display: flex; flex-direction: column; font-size: 17px; }
  :global(.cmp-vals) { font-size: 14px; color: var(--ink-2); }
  :global(.cmp-track) { flex: 1 1 380px; min-width: 0; position: relative; height: 34px; }
  :global(.cmp-seg) { position: absolute; top: 16px; height: 2px; background: #8fa3a2; }
  :global(.cmp-dot) { position: absolute; top: 10px; width: 14px; height: 14px; margin-left: -7px; border-radius: 50%; box-shadow: 0 0 0 2px #fff; }
  .chart { margin: 0; display: flex; flex-direction: column; gap: 10px; overflow-x: auto; }
  .chart svg { width: 100%; min-width: 560px; height: auto; }
  .chart .grid { stroke: var(--line); stroke-width: 1; }
  .chart .axis { font: 500 12px var(--font-body); fill: var(--ink-3); }
  .chart .bar { fill: #008C99; }
  .chart .bar.peak { fill: #C47F00; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
  table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 16px; }
  th { background: var(--ink); color: #fff; text-align: left; padding: 12px 14px; font-weight: 600; }
  td { padding: 11px 14px; border-top: 1px solid var(--line); }
  .num { text-align: right; }
</style>
